[
  {
    "number": 1,
    "name": "乾为天",
    "short_name": "乾",
    "symbol": "䷀",
    "bits_bottom_up": "111111",
    "upper_trigram": "乾",
    "lower_trigram": "乾",
    "judgment": "乾：元亨。利贞。",
    "lines": [
      "初九：潜龙勿用。",
      "九二：见龙在田，利见大人。",
      "九三：君子终日乾乾，夕惕若；厉，无咎。",
      "九四：或跃在渊，无咎。",
      "九五：飞龙在天，利见大人。",
      "上九：亢龙，有悔。"
    ],
    "special_text": "用九：见群龙无首，吉。",
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E4%B9%BE",
    "source_sha256": "e8b8c4a93f7e1f86e00e83635a12423da0e134ec463ea21837f6a41b41661156",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "刚健有为",
    "interpretation": "天行刚健，宜自强不息，进取须得其时。",
    "theme": "刚健有为"
  },
  {
    "number": 2,
    "name": "坤为地",
    "short_name": "坤",
    "symbol": "䷁",
    "bits_bottom_up": "000000",
    "upper_trigram": "坤",
    "lower_trigram": "坤",
    "judgment": "坤：元亨。利牝马之贞。",
    "lines": [
      "初六：履霜，坚冰至。",
      "六二：直方大，不习无不利。",
      "六三：含章，可贞。或从王事，无成有终。",
      "六四：括囊，无咎无誉。",
      "六五：黄裳，元吉。",
      "上六：龙战于野，其血玄黄。"
    ],
    "special_text": "用六：利永贞。",
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%9D%A4",
    "source_sha256": "a229442f54886cd2b21b1b6ab19cb377c4c59e5fcd8ac6b75f44b846459ca881",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "厚德承载",
    "interpretation": "地势柔顺，宜厚德载物，承事而不争先。",
    "theme": "厚德承载"
  },
  {
    "number": 3,
    "name": "水雷屯",
    "short_name": "屯",
    "symbol": "䷂",
    "bits_bottom_up": "100010",
    "upper_trigram": "坎",
    "lower_trigram": "震",
    "judgment": "屯：元亨，利贞。勿用有攸往，利建侯。",
    "lines": [
      "初九：桓，利居贞，利建侯。",
      "六二：屯如邅如，乘马班如，匪寇婚媾，女子贞不字，十年乃字。",
      "六三：即鹿无虞，惟入于林中，君子几不如舍，往吝。",
      "六四：乘马班如，求婚媾，往，吉无不利。",
      "九五：屯其膏；小贞吉，大贞凶。",
      "上六：乘马班如，泣血涟如。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B1%AF",
    "source_sha256": "46e879adeb27dcbf7d8b7d0763fddf786025ad617ea3dccf364195467e8c4096",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "初难待成",
    "interpretation": "草创多阻，宜先立根基，不宜急求通达。",
    "theme": "初难待成"
  },
  {
    "number": 4,
    "name": "山水蒙",
    "short_name": "蒙",
    "symbol": "䷃",
    "bits_bottom_up": "010001",
    "upper_trigram": "艮",
    "lower_trigram": "坎",
    "judgment": "蒙：亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
    "lines": [
      "初六：发蒙，利用刑人，用说桎梏，以往吝。",
      "九二：包蒙吉，纳妇吉，子克家。",
      "六三：勿用女，见金夫，不有躬，无攸利。",
      "六四：困蒙，吝。",
      "六五：童蒙，吉。",
      "上九：击蒙，不利为寇，利御寇。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%92%99",
    "source_sha256": "82968b32bb6552880209f9578ada9d2e30beadcc1fd2c59ee7d331c48dc9ea7b",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "启蒙求正",
    "interpretation": "事理未明，宜虚心求教，循序辨明所向。",
    "theme": "启蒙求正"
  },
  {
    "number": 5,
    "name": "水天需",
    "short_name": "需",
    "symbol": "䷄",
    "bits_bottom_up": "111010",
    "upper_trigram": "坎",
    "lower_trigram": "乾",
    "judgment": "需：有孚，光亨。贞吉，利涉大川。",
    "lines": [
      "初九：需于郊，利用恒，无咎。",
      "九二：需于沙，小有言，终吉。",
      "九三：需于泥，致寇至。",
      "六四：需于血，出自穴。",
      "九五：需于酒食，贞吉。",
      "上六：入于穴，有不速之客三人来，敬之终吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%9C%80",
    "source_sha256": "ccff1d03f4da5a90b388b3ec308fef5aa49ad588ad480be8627d633a3ad5bac3",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "守信待时",
    "interpretation": "前有险阻，宜守信蓄力，待时而进。",
    "theme": "守信待时"
  },
  {
    "number": 6,
    "name": "天水讼",
    "short_name": "讼",
    "symbol": "䷅",
    "bits_bottom_up": "010111",
    "upper_trigram": "乾",
    "lower_trigram": "坎",
    "judgment": "讼：有孚，窒，惕，中吉，终凶。利见大人，不利涉大川。",
    "lines": [
      "初六：不永所事，小有言，终吉。",
      "九二：不克讼，归而逋，其邑人三百户无眚。",
      "六三：食旧德，贞厉，终吉。或从王事，无成。",
      "九四：不克讼，复即命渝，安贞吉。",
      "九五：讼，元吉。",
      "上九：或锡之鞶带，终朝三之。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%A8%9F",
    "source_sha256": "8c6b14ac0b22d80ed48dd164132905c4dbdec9b3dda633744271e4bef064ee81",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "止争息讼",
    "interpretation": "意见相违，宜明辨事理，争端不可穷追到底。",
    "theme": "止争息讼"
  },
  {
    "number": 7,
    "name": "地水师",
    "short_name": "师",
    "symbol": "䷆",
    "bits_bottom_up": "010000",
    "upper_trigram": "坤",
    "lower_trigram": "坎",
    "judgment": "师：贞丈人吉，无咎。",
    "lines": [
      "初六：师出以律，否臧，凶。",
      "九二：在师中吉，无咎；王三锡命。",
      "六三：师或舆尸，凶。",
      "六四：师左次，无咎。",
      "六五：田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。",
      "上六：大君有命，开国承家，小人勿用。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B8%AB",
    "source_sha256": "131b206cbc0995b1adfdab9560e66d7843fd85e3172bb4e9f89bb37e4665c1f9",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "统众以正",
    "interpretation": "众力须有统领，宜纪律分明，以正道任事。",
    "theme": "统众以正"
  },
  {
    "number": 8,
    "name": "水地比",
    "short_name": "比",
    "symbol": "䷇",
    "bits_bottom_up": "000010",
    "upper_trigram": "坎",
    "lower_trigram": "坤",
    "judgment": "比：吉。原筮元永贞，无咎。不宁方来，后夫凶。",
    "lines": [
      "初六：有孚，比之，无咎。有孚盈缶，终来有它，吉。",
      "六二：比之自内，贞吉。",
      "六三：比之匪人。",
      "六四：外比之，贞吉。",
      "九五：显比。王用三，失前禽，邑人不诫，吉。",
      "上六：比之无首，凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%AF%94",
    "source_sha256": "c722de4c7a95194e064b0c39c40c4712af8f007bf2186bc0d4f207e1fb0406e0",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "亲比得助",
    "interpretation": "亲近相辅，宜择善而从，以诚信结交。",
    "theme": "亲比得助"
  },
  {
    "number": 9,
    "name": "风天小畜",
    "short_name": "小畜",
    "symbol": "䷈",
    "bits_bottom_up": "111011",
    "upper_trigram": "巽",
    "lower_trigram": "乾",
    "judgment": "小畜：亨。密云不雨，自我西郊。",
    "lines": [
      "初九：复自道，何其咎，吉。",
      "九二：牵复，吉。",
      "九三：说，夫妻反目。",
      "六四：有孚，血去惕出，无咎。",
      "九五：有孚挛如，富以其邻。",
      "上九：既雨既处，尚载，妇贞厉，月几望，君子征凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B0%8F%E7%95%9C",
    "source_sha256": "6e1e827c09da249c5391f31c860080fd05657107b62c7e109c31a038349aebb9",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "蓄小待时",
    "interpretation": "所蓄尚小，宜积累条件，未可骤然有为。",
    "theme": "蓄小待时"
  },
  {
    "number": 10,
    "name": "天泽履",
    "short_name": "履",
    "symbol": "䷉",
    "bits_bottom_up": "110111",
    "upper_trigram": "乾",
    "lower_trigram": "兑",
    "judgment": "履虎尾，不咥人，亨。",
    "lines": [
      "初九：素履，往无咎。",
      "九二：履道坦坦，幽人贞吉。",
      "六三：眇能视，跛能履，履虎尾，咥人，凶。武人为于大君。",
      "九四：履虎尾，愬愬终吉。",
      "九五：夬履，贞厉。",
      "上九：视履考详，其旋元吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B1%A5",
    "source_sha256": "4cba3bd1b9e4d13bb34a71531611e37bebb7801d8e783c86870912540453cd49",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "谨履知分",
    "interpretation": "行近险处，宜辨明礼序，谨慎进退。",
    "theme": "谨履知分"
  },
  {
    "number": 11,
    "name": "地天泰",
    "short_name": "泰",
    "symbol": "䷊",
    "bits_bottom_up": "111000",
    "upper_trigram": "坤",
    "lower_trigram": "乾",
    "judgment": "泰：小往大来，吉亨。",
    "lines": [
      "初九：拔茅茹以其汇，征吉。",
      "九二：包荒。用冯河，不遐遗；朋亡。得尚于中行。",
      "九三：无平不陂，无往不复，艰贞无咎。勿恤其孚，于食有福。",
      "六四：翩翩，不富以其邻；不戒以孚。",
      "六五：帝乙归妹，以祉，元吉。",
      "上六：城复于隍，勿用师，自邑告命，贞吝。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%B3%B0",
    "source_sha256": "ecd49dba63369af09ab717293badc4b5823106b89c25ee5ebed44466817616e7",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "通泰知节",
    "interpretation": "上下交泰，通达有时，宜居安思变，守正持盈。",
    "theme": "通泰知节"
  },
  {
    "number": 12,
    "name": "天地否",
    "short_name": "否",
    "symbol": "䷋",
    "bits_bottom_up": "000111",
    "upper_trigram": "乾",
    "lower_trigram": "坤",
    "judgment": "否之匪人，不利君子贞，大往小来。",
    "lines": [
      "初六，拔茅茹以其汇，贞吉。亨。",
      "六二，包承，小人吉，大人否。亨。",
      "六三，包羞。",
      "九四，有命，无咎，畴离祉。",
      "九五，休否，大人吉。其亡其亡，系于桑。",
      "上九，倾否，先否后喜。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%90%A6",
    "source_sha256": "40db949fcb2f204562ec6ba5377425cbc4261c46cc04e0748fdf399d5bb56fef",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "闭塞守正",
    "interpretation": "上下不交，宜收敛锋芒，守其正而待通。",
    "theme": "闭塞守正"
  },
  {
    "number": 13,
    "name": "天火同人",
    "short_name": "同人",
    "symbol": "䷌",
    "bits_bottom_up": "101111",
    "upper_trigram": "乾",
    "lower_trigram": "离",
    "judgment": "同人于野，亨。 利涉大川，利君子贞。",
    "lines": [
      "初九：同人于门，无咎。",
      "六二：同人于宗，吝。",
      "九三：伏戎于莽，升其高陵，三岁不兴。",
      "九四：乘其，弗克攻，吉。",
      "九五：同人，先号啕而后笑。大师克相遇。",
      "上九：同人于郊，无悔。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%90%8C%E4%BA%BA",
    "source_sha256": "c60417d5fd75abf7a958e368c092afadb2357e0d1af69085a1abe990c05a3d37",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "同道相成",
    "interpretation": "与人同心，贵在公正坦诚，不宜结党徇私。",
    "theme": "同道相成"
  },
  {
    "number": 14,
    "name": "火天大有",
    "short_name": "大有",
    "symbol": "䷍",
    "bits_bottom_up": "111101",
    "upper_trigram": "离",
    "lower_trigram": "乾",
    "judgment": "大有：元亨。",
    "lines": [
      "初九：无交害，匪咎，艰则无咎。",
      "九二：大以载，有攸往，无咎。",
      "九三：公用亨于天子，小人弗克。",
      "九四：匪其，无咎。",
      "六五：厥孚交如，威如；吉。",
      "上九：自天之，吉无不利。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%A4%A7%E6%9C%89",
    "source_sha256": "3c4fdab8bfd0a57bfe53c483c5ad32a308d58094167a8dbb52b16c8c4c26ef0c",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "有余守谦",
    "interpretation": "所获丰厚，宜明德善用，不以富有自满。",
    "theme": "有余守谦"
  },
  {
    "number": 15,
    "name": "地山谦",
    "short_name": "谦",
    "symbol": "䷎",
    "bits_bottom_up": "001000",
    "upper_trigram": "坤",
    "lower_trigram": "艮",
    "judgment": "谦：亨，君子有终。",
    "lines": [
      "初六：谦谦君子，用涉大川，吉。",
      "六二：鸣谦，贞吉。",
      "九三：劳谦君子，有终吉。",
      "六四：无不利，㧑谦。",
      "六五：不富，以其邻，利用侵伐，无不利。",
      "上六：鸣谦，利用行师，征邑国。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%AC%99",
    "source_sha256": "2ffb3b0269b10fe966f76b4dd96b49503733677215fa6b9df7414a0a903d3700",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "谦抑受益",
    "interpretation": "有德而不自居，宜谦退有节，以诚受益。",
    "theme": "谦抑受益"
  },
  {
    "number": 16,
    "name": "雷地豫",
    "short_name": "豫",
    "symbol": "䷏",
    "bits_bottom_up": "000100",
    "upper_trigram": "震",
    "lower_trigram": "坤",
    "judgment": "豫：利建侯行师。",
    "lines": [
      "初六：鸣豫，凶。",
      "六二：介于石，不终日，贞吉。",
      "六三：盱豫，悔。迟有悔。",
      "九四：由豫，大有得。勿疑。朋盍。",
      "六五：贞疾，恒不死。",
      "上六：冥豫，成有渝，无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%B1%AB",
    "source_sha256": "65bf434245ce44f90a7034ebef4159cd64b85f7cdb099c7f52e8820215bbfe5b",
    "text_version": "wikisource-2026-10-26-hans-v1",
    "reading_title": "和乐有备",
    "interpretation": "和乐可以聚众，宜豫先有备，不可沉溺安逸。",
    "theme": "和乐有备"
  },
  {
    "number": 17,
    "name": "泽雷随",
    "short_name": "随",
    "symbol": "䷐",
    "bits_bottom_up": "100110",
    "upper_trigram": "兑",
    "lower_trigram": "震",
    "judgment": "随：元亨。利贞。无咎。",
    "lines": [
      "初九：官有渝，贞吉。出门交有功。",
      "六二：系小子，失丈夫。",
      "六三：系丈夫，失小子。随，有求得利，居贞。",
      "九四：随有获，贞凶。有孚在道，以明，何咎。",
      "九五：孚于嘉，吉。",
      "上六：拘系之，乃从维之。王用亨于西山。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%9A%A8",
    "source_sha256": "af3531608314476f887b4c8adc97ccf6c2ca09abf5718d4643be598cdda4a8d0",
