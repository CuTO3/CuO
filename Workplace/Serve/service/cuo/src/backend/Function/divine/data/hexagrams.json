  {
    "number": 21,
    "name": "火雷噬嗑",
    "short_name": "噬嗑",
    "symbol": "䷔",
    "bits_bottom_up": "100101",
    "upper_trigram": "離",
    "lower_trigram": "震",
    "judgment": "噬嗑：亨。利用獄。",
    "lines": [
      "初九：屨校滅趾，无咎。",
      "六二：噬膚滅鼻，无咎。",
      "六三：噬肉，遇毒；小吝，无咎。",
      "九四：噬乾胏，得金矢，利艱貞，吉。",
      "六五：噬乾肉，得黃金，貞厲，无咎。",
      "上九：何校滅耳，凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%99%AC%E5%97%91",
    "source_sha256": "cbfa0c3f32152b3c31c91624dddc4abd7b8217b7121507fecb8a68d7dc68ecee",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 22,
    "name": "山火賁",
    "short_name": "賁",
    "symbol": "䷕",
    "bits_bottom_up": "101001",
    "upper_trigram": "艮",
    "lower_trigram": "離",
    "judgment": "賁：亨。小利有攸往。",
    "lines": [
      "初九：賁其趾，舍車而徒。",
      "六二：賁其須。",
      "九三：賁如濡如，永貞吉。",
      "六四：賁如皤如，白馬翰如，匪寇婚媾。",
      "六五：賁於丘園，束帛戔戔，吝，終吉。",
      "上九：白賁，无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%B3%81",
    "source_sha256": "f7418a0d3805c366e3afc6e9c7fb32c0c1da7883bf714cbe6235fe477365773c",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 23,
    "name": "山地剝",
    "short_name": "剝",
    "symbol": "䷖",
    "bits_bottom_up": "000001",
    "upper_trigram": "艮",
    "lower_trigram": "坤",
    "judgment": "剝：不利。有攸往。",
    "lines": [
      "初六：剝牀以足，蔑貞凶。",
      "六二：剝牀以辨，蔑貞凶。",
      "六三：剝之，无咎。",
      "六四：剝牀以膚，凶。",
      "六五：貫魚，以宮人寵，无不利。",
      "上九：碩果不食，君子，小人剝廬。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%89%9D",
    "source_sha256": "641e20b6320b0c6d6bce4b0856297382547a9ae0f5b4da7ea219944208773090",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 24,
    "name": "地雷復",
    "short_name": "復",
    "symbol": "䷗",
    "bits_bottom_up": "100000",
    "upper_trigram": "坤",
    "lower_trigram": "震",
    "judgment": "復：亨。出入无疾，朋來无咎。反復其道，七日來復，利有攸往。",
    "lines": [
      "初九：不遠復，无祇悔，元吉。",
      "六二：休復，吉。",
      "六三：頻復，厲无咎。",
      "六四：中行獨復。",
      "六五：敦復，无悔。",
      "上六：迷復，凶，有災眚。用行師，終有大敗，以其國君，凶；至于十年，不克征。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%BE%A9",
    "source_sha256": "f798cd72e1c558fb9bcd640ee52ba089ca7b0f6f5be3e26c804c8a7733a17b5a",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 25,
    "name": "天雷無妄",
    "short_name": "無妄",
    "symbol": "䷘",
    "bits_bottom_up": "100111",
    "upper_trigram": "乾",
    "lower_trigram": "震",
    "judgment": "无妄：元亨。利貞。其匪正有眚，不利有攸往。",
    "lines": [
      "初九：无妄，往吉。",
      "六二：不耕穫，不菑畬，則利有攸往。",
      "六三：无妄之災，或繫之牛，行人之得，邑人之災。",
      "九四：可貞，无咎。",
      "九五：无妄之疾，勿藥有喜。",
      "上九：无妄，行有眚，无攸利。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E7%84%A1%E5%A6%84",
    "source_sha256": "c11bc5a60fde2c199374195527cee4102ef5e5b755b7cb2bb44454eec95fd310",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 26,
    "name": "山天大畜",
    "short_name": "大畜",
    "symbol": "䷙",
    "bits_bottom_up": "111001",
    "upper_trigram": "艮",
    "lower_trigram": "乾",
    "judgment": "大畜：利貞，不家食吉，利涉大川。",
    "lines": [
      "初九：有厲利已。",
      "九二：輿說。",
      "九三：良馬逐，利艱貞，吉。日閑輿衛，利有攸往。",
      "六四：童牛之，元吉。",
      "六五：豶豕之牙，吉。",
      "上九：何天之衢，亨。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%A4%A7%E7%95%9C",
    "source_sha256": "5cfe64d4db6fea5edd781f4ee13b6465e27d62e1cb1ee777121b158700bbfeaa",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 27,
    "name": "山雷頤",
    "short_name": "頤",
    "symbol": "䷚",
    "bits_bottom_up": "100001",
    "upper_trigram": "艮",
    "lower_trigram": "震",
    "judgment": "頤：貞吉。觀頤，自求口實。",
    "lines": [
      "初九：舍爾靈龜，觀我朵頤，凶。",
      "六二：顛頤，拂經，于丘頤，征凶。",
      "六三：拂頤，貞凶，十年勿用，无攸利。",
      "六四：顛頤吉，虎視眈眈，其欲逐逐，无咎。",
      "六五：拂經，居貞吉，不可涉大川。",
      "上九：由頤，厲吉，利涉大川。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%A0%A4",
    "source_sha256": "d356ddc403ae8a2923c8805df8854b44b65eaa39c430b41a7924ea55593f320a",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 28,
    "name": "澤風大過",
    "short_name": "大過",
    "symbol": "䷛",
    "bits_bottom_up": "011110",
    "upper_trigram": "兌",
    "lower_trigram": "巽",
    "judgment": "大過：棟橈，利有攸往，亨。",
    "lines": [
      "初六：藉用白茅，无咎。",
      "九二：枯楊生稊，老夫得其女妻，无不利。",
      "九三：棟橈，凶。",
      "九四：棟隆，吉。有它吝。",
      "九五：枯楊生華，老婦得其士夫，无咎无譽。",
      "上六：過涉滅頂，凶，无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%A4%A7%E9%81%8E",
    "source_sha256": "1249e5a4ebb965dc31392541cf4f2b2892361c3b7a147eea0d79d7050778490f",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 29,
    "name": "坎為水",
    "short_name": "坎",
    "symbol": "䷜",
    "bits_bottom_up": "010010",
    "upper_trigram": "坎",
    "lower_trigram": "坎",
    "judgment": "習坎：有孚，維心亨。行有尚。",
    "lines": [
      "初六：習坎，入于坎窞，凶。",
      "九二：坎有險，求小得。",
      "六三：來之坎坎，險且枕，入于坎窞，勿用。",
      "六四：，終无咎。",
      "九五：坎不盈，既平，无咎。",
      "上六：係用徽纆，寘于叢棘，三歲不得，凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%9D%8E",
    "source_sha256": "67649ec92aad923c487b99d0eadb244f47fd81ac9ec1fc41c991cae52fe8c980",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 30,
    "name": "離為火",
    "short_name": "離",
    "symbol": "䷝",
    "bits_bottom_up": "101101",
    "upper_trigram": "離",
    "lower_trigram": "離",
    "judgment": "離：利貞。亨。畜牝牛，吉。",
    "lines": [
      "初九：履錯然，敬之无咎。",
      "六二：黃離，元吉。",
      "九三：日昃之離，不鼓缶而歌，則大耋之，凶。",
      "九四：突如其來如，焚如，死如，棄如。",
      "六五：出涕沱若，戚嗟若，吉。",
      "上九：王用出征，有嘉折首，獲匪其醜，无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%9B%A2",
    "source_sha256": "441acca23398f8f80692371d6f6210c53ee2d945f3f77df0f649b2eb9da02ec9",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 31,
    "name": "澤山咸",
    "short_name": "咸",
    "symbol": "䷞",
    "bits_bottom_up": "001110",
    "upper_trigram": "兌",
    "lower_trigram": "艮",
    "judgment": "咸：亨。利貞。取女吉。",
    "lines": [
      "初六：咸其。",
      "六二：咸其腓，凶，居吉。",
      "九三：咸其股，執其隨，往吝。",
      "九四：貞吉悔亡，憧憧往來，朋從爾思。",
      "九五：咸其脢，无悔。",
      "上六：咸其輔，頰，舌。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%92%B8",
    "source_sha256": "fb35b42cf24d00ebc1532456ea7832c2d30f99fa52ba76c778451aa31a8d85ff",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 32,
    "name": "雷風恆",
    "short_name": "恆",
    "symbol": "䷟",
    "bits_bottom_up": "011100",
    "upper_trigram": "震",
    "lower_trigram": "巽",
    "judgment": "恆：亨，无咎。利貞，利有攸往。",
    "lines": [
      "初六：浚恆，貞凶，无攸利。",
      "九二：悔亡。",
      "九三：不恆其德，或承之羞，貞吝。",
      "九四：田无禽。",
      "六五：恆其德，貞，婦人吉，夫子凶。",
      "上六：恆，凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%81%86",
    "source_sha256": "e9c83f30c75539487013066246e4f8cbf27bde372ec46b4e47c609e0622b67bc",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 33,
    "name": "天山遯",
    "short_name": "遯",
    "symbol": "䷠",
    "bits_bottom_up": "001111",
    "upper_trigram": "乾",
    "lower_trigram": "艮",
    "judgment": "遯：亨。小利貞。",
    "lines": [
      "初六：遯尾，厲，勿用有攸往。",
      "六二：執之用黃牛之革，莫之勝說。",
      "九三：係遯，有疾厲，畜臣妾吉。",
      "九四：好遯君子吉，小人否。",
      "九五：嘉遯，貞吉。",
      "上九：肥遯，无不利。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%81%AF",
    "source_sha256": "2676bbe35fe01a331f62ce09665031ce05435a5b8f9bc2bb49a4ae761c0751fb",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 34,
    "name": "雷天大壯",
    "short_name": "大壯",
    "symbol": "䷡",
    "bits_bottom_up": "111100",
    "upper_trigram": "震",
    "lower_trigram": "乾",
    "judgment": "大壯：利貞。",
    "lines": [
      "初九：壯于趾，征凶，有孚。",
      "九二：貞吉。",
      "九三：小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。",
      "九四：貞吉悔亡，藩決不羸，壯于大之。",
      "六五：喪羊于易，无悔。",
      "上六：羝羊觸藩，不能退，不能遂，无攸利，艱則吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%A4%A7%E5%A3%AF",
    "source_sha256": "cddc93eed027f6a988901d305169ec51ba9b38c783b14488de6f1b141aec868b",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 35,
    "name": "火地晉",
    "short_name": "晉",
    "symbol": "䷢",
    "bits_bottom_up": "000101",
    "upper_trigram": "離",
    "lower_trigram": "坤",
    "judgment": "晉：康侯用錫馬蕃庶，晝日三接。",
    "lines": [
      "初六：晉如，摧如，貞吉。罔孚，裕无咎。",
      "六二：晉如，愁如，貞吉。受茲介福，于其王母。",
      "六三：眾允，悔亡。",
      "九四：晉如鼠，貞厲。",
      "六五：悔亡，得勿恤，往吉无不利。",
      "上九：晉其角，維用伐邑，厲吉无咎，貞吝。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%99%89",
    "source_sha256": "7322474e504b7919ee7f29188f90aade0c384a2e5f4570de3eea3c8cbb083354",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 36,
    "name": "地火明夷",
    "short_name": "明夷",
    "symbol": "䷣",
    "bits_bottom_up": "101000",
    "upper_trigram": "坤",
    "lower_trigram": "離",
    "judgment": "明夷：利艱貞。",
    "lines": [
      "初九：明夷于飛，垂其翼。君子于行，三日不食，有攸往，主人有言。",
      "六二：明夷，夷于左股，用拯馬壯，吉。",
      "九三：明夷于南狩，得其大首，不可疾貞。",
      "六四：入于左腹，獲明夷之心，于出門庭。",
      "六五：箕子之明夷，利貞。",
      "上六：不明晦，初登于天，後入于地。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%98%8E%E5%A4%B7",
    "source_sha256": "4d341536c62fa6e76cf02602e433eaff9a377efc8ed19258b85ae6ada8aea0ab",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 37,
    "name": "風火家人",
    "short_name": "家人",
    "symbol": "䷤",
    "bits_bottom_up": "101011",
    "upper_trigram": "巽",
    "lower_trigram": "離",
    "judgment": "家人：利女貞。",
    "lines": [
      "初九：閑有家，悔亡。",
      "六二：无攸遂，在中饋，貞吉。",
      "九三：家人嗃嗃，悔厲吉；婦子嘻嘻，終吝。",
      "六四：富家，大吉。",
      "九五：王假有家，勿恤。吉。",
      "上九：有孚威如，終吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%AE%B6%E4%BA%BA",
    "source_sha256": "0179c8e76f2ef04ee811c1acf142f707d29083fe324de7c4cd086ceb47f79c99",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 38,
    "name": "火澤睽",
    "short_name": "睽",
    "symbol": "䷥",
    "bits_bottom_up": "110101",
    "upper_trigram": "離",
    "lower_trigram": "兌",
    "judgment": "睽：小事吉。",
    "lines": [
      "初九：悔亡，喪馬勿逐，自復；見惡人无咎。",
      "九二：遇主于巷，无咎。",
      "六三：見輿曳，其牛，其人天且劓，无初有終。",
      "九四：睽孤，遇元夫，交孚，厲无咎。",
      "六五：悔亡，厥宗噬膚，往何咎。",
      "上九：睽孤， 見豕負涂，載鬼一車， 先張之弧，後說之弧，匪寇婚媾，往遇雨則吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E7%9D%BD",
    "source_sha256": "e992371a0dc8ee58aba5f44f8ede6205712dbdad25edb7c030a1dcf12f067706",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 39,
    "name": "水山蹇",
    "short_name": "蹇",
    "symbol": "䷦",
    "bits_bottom_up": "001010",
    "upper_trigram": "坎",
    "lower_trigram": "艮",
    "judgment": "蹇：利西南，不利東北；利見大人，貞吉。",
    "lines": [
      "初六：往蹇，來譽。",
      "六二：王臣蹇蹇，匪躬之故。",
      "九三：往蹇來反。",
      "六四：往蹇來連。",
      "九五：大蹇朋來。",
      "上六：往蹇來碩，吉；利見大人。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%B9%87",
    "source_sha256": "4fca7850987f383c2a66b195c5c35c5f39be0c41877c5607013d6a9858d7066b",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 40,
    "name": "雷水解",
    "short_name": "解",
    "symbol": "䷧",
    "bits_bottom_up": "010100",
    "upper_trigram": "震",
    "lower_trigram": "坎",
    "judgment": "解：利西南，无所往，其來復吉。有攸往，夙吉。",
    "lines": [
      "初六：无咎。",
      "九二：田獲三狐，得黃矢，貞吉。",
      "六三：負且乘，致寇至，貞吝。",
      "九四：解而拇，朋至斯孚。",
      "六五：君子有解，吉；有孚于小人。",
      "上六：公用射隼，于高之上，獲之，无不利。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%A7%A3",
    "source_sha256": "46fd421e644b9e766810bc08b912d61b680d17a3b5a420311d5bf75289a831f2",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 41,
    "name": "山澤損",
    "short_name": "損",
    "symbol": "䷨",
    "bits_bottom_up": "110001",
    "upper_trigram": "艮",
    "lower_trigram": "兌",
    "judgment": "損：有孚，元吉。无咎，可貞，利有攸往。曷之用？二簋可用享。",
    "lines": [
      "初九：事遄往，无咎，酌損之。",
      "九二：利貞，征凶，弗損益之。",
      "六三：三人行，則損一人；一人行，則得其友。",
      "六四：損其疾，使遄有喜，无咎。",
      "六五：或益之，十朋之龜弗克違，元吉。",
      "上九：弗損益之，无咎，貞吉，利有攸往，得臣无家。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%90%8D",
    "source_sha256": "35cd31fa7274be23f261cdbeedea2764f755f2b9216e187ebd7cb19f104e7cea",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 42,
    "name": "風雷益",
    "short_name": "益",
    "symbol": "䷩",
    "bits_bottom_up": "100011",
    "upper_trigram": "巽",
    "lower_trigram": "震",
    "judgment": "益：利有攸往。利涉大川。",
    "lines": [
      "初九：利用為大作，元吉，无咎。",
      "六二：或益之，十朋之龜弗克違，永貞吉。王用享于帝，吉。",
      "六三：益之用凶事，无咎。有孚中行，告公用圭。",
      "六四：中行，告公從。利用為依遷。",
      "九五：有孚惠心，勿問元吉。有孚惠我德。",
      "上九：莫益之，或擊之，立心勿恆，凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E7%9B%8A",
    "source_sha256": "b6b667ee48181cb28e9ba3a96f5e9f209d30a5a50396594c55b5260b5cb29aee",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 43,
    "name": "澤天夬",
    "short_name": "夬",
    "symbol": "䷪",
    "bits_bottom_up": "111110",
    "upper_trigram": "兌",
    "lower_trigram": "乾",
    "judgment": "夬：揚于王庭，孚號，有厲，告自邑，不利即戎，利有攸往。",
    "lines": [
      "初九：壯于前趾，往不勝為咎。",
      "九二：惕號，莫夜有戎，勿恤。",
      "九三：壯于頄，有凶。君子夬夬，獨行遇雨，若濡有慍，无咎。",
      "九四：臀无膚，其行次且。牽羊悔亡，聞言不信。",
      "九五：莧陸夬夬，中行无咎。",
      "上六：无號，終有凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%A4%AC",
    "source_sha256": "1dbda1e9e07a19fe4ff04491bf7f99b3b9c501702773972d647745c2c5f4b0aa",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 44,
    "name": "天風姤",
    "short_name": "姤",
    "symbol": "䷫",
    "bits_bottom_up": "011111",
    "upper_trigram": "乾",
    "lower_trigram": "巽",
    "judgment": "姤：女壯，勿用取女。",
    "lines": [
      "初六：系于金柅，貞吉，有攸往，見凶，羸豕，孚，。",
      "九二：包有魚，无咎，不利賓。",
      "九三：臀无膚，其行次且，厲，无大咎。",
      "九四：包无魚，起凶。",
      "九五：以杞瓜，含章，有隕自天。",
      "上九：姤其角，吝，无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%A7%A4",
    "source_sha256": "6b32ae120b58931145ddff8085f5c56e45f7c52c3a1cb6a5c6a49d3b358819e3",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 45,
    "name": "澤地萃",
    "short_name": "萃",
    "symbol": "䷬",
    "bits_bottom_up": "000110",
    "upper_trigram": "兌",
    "lower_trigram": "坤",
    "judgment": "萃：王假有廟，利見大人，亨。利貞。用大牲吉，利有攸往。",
    "lines": [
      "初六：有孚不終，乃亂乃萃，若號一握為笑，勿恤，往无咎。",
      "六二：引吉，无咎，孚乃利用禴。",
      "六三：萃如，嗟如，无攸利，往无咎，小吝。",
      "九四：大吉，无咎。",
      "九五：萃有位，无咎。匪孚，元永貞，悔亡。",
      "上六：齎涕洟，无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%90%83",
    "source_sha256": "f353e767fdeeca38561dfe43a34c587366154bad4ab6e5899924045b28da1c14",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 46,
    "name": "地風升",
    "short_name": "升",
    "symbol": "䷭",
    "bits_bottom_up": "011000",
    "upper_trigram": "坤",
    "lower_trigram": "巽",
    "judgment": "升：元亨，用見大人，勿恤，南征吉。",
    "lines": [
      "初六：允升，大吉。",
      "九二：孚乃利用禴，无咎。",
      "九三：升虛邑。",
      "六四：王用于岐山，吉无咎。",
      "六五：貞吉，升階。",
      "上六：冥升，利于不息之貞。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%8D%87",
    "source_sha256": "443fb95dd115611d330e6ff8c5e71cde43295b15c5004bd1e2e7ecdf4754f742",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 47,
    "name": "澤水困",
    "short_name": "困",
    "symbol": "䷮",
    "bits_bottom_up": "010110",
    "upper_trigram": "兌",
    "lower_trigram": "坎",
    "judgment": "困：亨，貞大人吉，无咎，有言不信。",
    "lines": [
      "初六：臀困于株木，入于幽谷，三歲不覿。",
      "九二：困于酒食，朱紱方來，利用亨祀，征凶，无咎。",
      "六三：困于石，據于蒺，入于其宮，不見其妻，凶。",
      "九四：來，困于金，吝，有終。",
      "九五：劓刖，困于赤紱，乃徐有說，利用祭祀。",
      "上六：困于葛藟，于臲卼，曰動悔。有悔，征吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%9B%B0",
    "source_sha256": "cc243ac371a6fa4df22160bc14f1d5ce8802849a778522758ec24b87fa562b8b",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 48,
    "name": "水風井",
    "short_name": "井",
    "symbol": "䷯",
    "bits_bottom_up": "011010",
    "upper_trigram": "坎",
    "lower_trigram": "巽",
    "judgment": "井：改邑不改井，无喪无得，往來井井。汔至亦未繘井。羸其瓶，凶。",
    "lines": [
      "初六：井泥不食，舊井无禽。",
      "九二：井谷射鮒，瓮敝漏。",
      "九三：井渫不食，為我心惻，可用汲，王明，並受其福。",
      "六四：井甃，无咎。",
      "九五：井冽，寒泉食。",
      "上六：井收勿幕，有孚元吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E4%BA%95",
    "source_sha256": "1ab27335076e1c166642c60b9f31789337a7da0c66ec4e3d9f28632786ff0914",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 49,
    "name": "澤火革",
    "short_name": "革",
    "symbol": "䷰",
    "bits_bottom_up": "101110",
    "upper_trigram": "兌",
    "lower_trigram": "離",
    "judgment": "革：已日乃孚，元亨。利貞。悔亡。",
    "lines": [
      "初九：鞏用黃牛之革。",
      "六二：已日乃革之，征吉，无咎。",
      "九三：征凶，貞厲，革言三就，有孚。",
      "九四：悔亡，有孚改命，吉。",
      "九五：大人虎變，未占有孚。",
      "上六：君子豹變，小人革面，征凶，居貞吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%9D%A9",
    "source_sha256": "095de39170ac0e2407fbebd131f3957b08f13d1aeea25eed4f331aa672fde643",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 50,
    "name": "火風鼎",
    "short_name": "鼎",
    "symbol": "䷱",
    "bits_bottom_up": "011101",
    "upper_trigram": "離",
    "lower_trigram": "巽",
    "judgment": "鼎：元吉，亨。",
    "lines": [
      "初六：鼎顛趾，利出否，得妾以其子，无咎。",
      "九二：鼎有實，我仇有疾，不我能即，吉。",
      "九三：鼎耳革，其行塞，雉膏不食，方雨虧悔，終吉。",
      "九四：鼎折足，覆公餗，其渥，凶。",
      "六五：鼎黃耳金鉉，利貞。",
      "上九：鼎玉鉉，大吉，无不利。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%BC%8E",
    "source_sha256": "f42593c252a3f9a3c5f3e0005959c887acb653016eef0b887bf51c129b841fa8",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 51,
    "name": "震為雷",
    "short_name": "震",
    "symbol": "䷲",
    "bits_bottom_up": "100100",
    "upper_trigram": "震",
    "lower_trigram": "震",
    "judgment": "震：亨。震來虩虩，笑言啞啞。震驚百里，不喪匕鬯。",
    "lines": [
      "初九：震來虩虩，後笑言啞啞，吉。",
      "六二：震來厲，億喪貝，躋于九陵，勿逐，七日得。",
      "六三：震蘇蘇，震行无眚。",
      "九四：震遂泥。",
      "六五：震往來厲，億无喪，有事。",
      "上六：震索索，視矍矍，征凶。震不于其躬，于其鄰，无咎。婚媾有言。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%9C%87",
    "source_sha256": "a91ae3f5544413961abcc2d134f79310de1f7bab2c81f7f29a42d309a75ad26a",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 52,
    "name": "艮為山",
    "short_name": "艮",
    "symbol": "䷳",
    "bits_bottom_up": "001001",
    "upper_trigram": "艮",
    "lower_trigram": "艮",
    "judgment": "艮：艮其背，不獲其身，行其庭，不見其人，无咎。",
    "lines": [
      "初六：艮其趾，无咎，利永貞。",
      "六二：艮其腓，不拯其隨，其心不快。",
      "九三：艮其限，其夤，厲心。",
      "六四：艮其身，无咎。",
      "六五：艮其輔，言有，悔亡。",
      "上九：敦艮，吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%89%AE",
    "source_sha256": "58c8311a879b6c5e764365d0beb1c946ae2a2e63784e1e1d6a946f387a0379ee",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 53,
    "name": "風山漸",
    "short_name": "漸",
    "symbol": "䷴",
    "bits_bottom_up": "001011",
    "upper_trigram": "巽",
    "lower_trigram": "艮",
    "judgment": "漸：女歸吉，利貞。",
    "lines": [
      "初六：鴻漸于干，小子厲，有言，无咎。",
      "六二：鴻漸于磐，飲食衎衎，吉。",
      "九三：鴻漸于陸，夫征不復，婦孕不育，凶；利禦寇。",
      "六四：鴻漸于木，或得其桷，无咎。",
      "九五：鴻漸于陵，婦三歲不孕，終莫之勝，吉。",
      "上九：鴻漸于陸，其羽可用為儀，吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%BC%B8",
    "source_sha256": "46da172e6576ba774f6c61741a2d566014f5e5fc90c1065251cb80ccd89b28d7",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 54,
    "name": "雷澤歸妹",
    "short_name": "歸妹",
    "symbol": "䷵",
    "bits_bottom_up": "110100",
    "upper_trigram": "震",
    "lower_trigram": "兌",
    "judgment": "歸妹：征凶，无攸利。",
    "lines": [
      "初九：歸妹以娣，跛能履，征吉。",
      "九二：眇視，利幽人之貞。",
      "六三：歸妹以須，反歸以娣。",
      "九四：歸妹愆期，遲歸有時。",
      "六五：帝乙歸妹，其君之袂，不如其娣之袂良，月幾望，吉。",
      "上六：女承筐无實，士刲羊无血，无攸利。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%AD%B8%E5%A6%B9",
    "source_sha256": "3b875fda93e1388dd9359d5185626e56e542344e07efe0659b02512595c992fd",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 55,
    "name": "雷火丰",
    "short_name": "丰",
    "symbol": "䷶",
    "bits_bottom_up": "101100",
    "upper_trigram": "震",
    "lower_trigram": "離",
    "judgment": "豐：亨。王假之，勿憂，宜日中。",
    "lines": [
      "初九：遇其配主，雖旬无咎，往有尚。",
      "六二：豐其蔀，日中見斗，往得疑疾，有孚發若，吉。",
      "九三：豐其沛，日中見沬，折其右肱，无咎。",
      "九四：豐其蔀，日中見斗，遇其夷主，吉。",
      "六五：來章，有慶譽，吉。",
      "上六：豐其屋，蔀其家，窺其戶，闃其无人，三歲不觌，凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E4%B8%B0",
    "source_sha256": "decc267b9a05f7779a16ca01bc00fce9bff4e650fd3b1195d0f97d91297df302",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 56,
    "name": "火山旅",
    "short_name": "旅",
    "symbol": "䷷",
    "bits_bottom_up": "001101",
    "upper_trigram": "離",
    "lower_trigram": "艮",
    "judgment": "旅：小亨，旅貞吉。",
    "lines": [
      "初六：旅瑣瑣，斯其所取災。",
      "六二：旅即次，懷其資，得僕貞。",
      "九三：旅焚其次，喪其僕，貞厲。",
      "九四：旅于處，得其資斧，我心不快。",
      "六五：射雉一矢亡，終以譽命。",
      "上九：鳥焚其巢，旅人先笑後號咷。喪牛于易，凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%97%85",
    "source_sha256": "3e8aed4bcd7651b4afde4fbfa7451fd15d632ad313d8760c1dda7d3d3c49e819",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 57,
    "name": "巽為風",
    "short_name": "巽",
    "symbol": "䷸",
    "bits_bottom_up": "011011",
    "upper_trigram": "巽",
    "lower_trigram": "巽",
    "judgment": "巽：小亨。利有攸往。利見大人。",
    "lines": [
      "初六：進退，利武人之貞。",
      "九二：巽在牀下，用史巫紛若，吉无咎。",
      "九三：頻巽，吝。",
      "六四：悔亡，田獲三品。",
      "九五：貞吉悔亡，无不利。无初有終，先庚三日，後庚三日，吉。",
      "上九：巽在牀下，喪其資斧，貞凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B7%BD",
    "source_sha256": "99a815af7cfac36d8d46784002467f6e70babf49e7fe4bb930976d0e78dc066c",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 58,
    "name": "兌為澤",
    "short_name": "兌",
    "symbol": "䷹",
    "bits_bottom_up": "110110",
    "upper_trigram": "兌",
    "lower_trigram": "兌",
    "judgment": "兌：亨。利貞。",
    "lines": [
      "初九：和兌，吉。",
      "九二：孚兌，吉，悔亡。",
      "六三：來兌，凶。",
      "九四：商兌，未寧，介疾有喜。",
      "九五：孚于剝，有厲。",
      "上六：引兌。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%85%8C",
    "source_sha256": "0ecebe0d070dcd3cdf07019a3f1d578cbcd4d1bb441c48b8536bb596e3e49850",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 59,
    "name": "風水渙",
    "short_name": "渙",
    "symbol": "䷺",
    "bits_bottom_up": "010011",
    "upper_trigram": "巽",
    "lower_trigram": "坎",
    "judgment": "渙：亨，王假有廟，利涉大川，利貞。",
    "lines": [
      "初六：用拯馬壯，吉，悔亡。",
      "九二：渙奔其机，悔亡。",
      "六三：渙其躬，无悔。",
      "六四：渙其群，元吉。渙有丘，匪夷所思。",
      "九五：渙汗其大號，渙王居，无咎。",
      "上九：渙其血，去逖出，无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%B8%99",
    "source_sha256": "9c8c9b4298fa8429c00ece4a08821a83f9a5692f9bba09eb26cd2e180850c76e",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 60,
    "name": "水澤節",
    "short_name": "節",
    "symbol": "䷻",
    "bits_bottom_up": "110010",
    "upper_trigram": "坎",
    "lower_trigram": "兌",
    "judgment": "節：亨。苦節不可貞。",
    "lines": [
      "初九：不出戶庭，无咎。",
      "九二：不出門庭，凶。",
      "六三：不節若，則嗟若，无咎。",
      "六四：安節，亨。",
      "九五：甘節，吉；往有尚。",
      "上六：苦節，貞凶，悔亡。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E7%AF%80",
    "source_sha256": "a017661595c6358621214894a41885648d4e2fe71af0d43ebd9f7b3f66517bcf",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 61,
    "name": "風澤中孚",
    "short_name": "中孚",
    "symbol": "䷼",
    "bits_bottom_up": "110011",
    "upper_trigram": "巽",
    "lower_trigram": "兌",
    "judgment": "中孚：豚魚吉，利涉大川，利貞。",
    "lines": [
      "初九：虞吉，有不燕。",
      "九二：鳴鶴在陰，其子和之，我有好爵，吾與爾靡之。",
      "六三：得敵，或鼓或罷，或泣或歌。",
      "六四：月望，馬匹亡，无咎。",
      "九五：有孚攣如，无咎。",
      "上九：翰音登于天，貞凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E4%B8%AD%E5%AD%9A",
    "source_sha256": "9048c101757a1c3a0f5e7ec3d79e0fa22ba121babbf7fc083b8a48e1a0514e2b",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 62,
    "name": "雷山小過",
    "short_name": "小過",
    "symbol": "䷽",
    "bits_bottom_up": "001100",
    "upper_trigram": "震",
    "lower_trigram": "艮",
    "judgment": "小過：亨。利貞。可小事，不可大事。飛鳥遺之音，不宜上宜下，大吉。",
    "lines": [
      "初六：飛鳥以凶。",
      "六二：過其祖，遇其妣；不及其君，遇其臣；无咎。",
      "九三：弗過防之，從或戕之，凶。",
      "九四：无咎，弗過遇之。往厲必戒，勿用永貞。",
      "六五：密雲不雨，自我西郊，公弋取彼在穴。",
      "上六：弗遇過之，飛鳥離之，凶，是謂災眚。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B0%8F%E9%81%8E",
    "source_sha256": "899bcfc5e793f63761f01098bc6997cbec4c71be84f183f763c553e69075f1cd",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 63,
    "name": "水火既濟",
    "short_name": "既濟",
    "symbol": "䷾",
    "bits_bottom_up": "101010",
    "upper_trigram": "坎",
    "lower_trigram": "離",
    "judgment": "既濟：亨小。利貞。初吉終亂。",
    "lines": [
      "初九：曳其輪，濡其尾，无咎。",
      "六二：婦喪其茀，勿逐，七日得。",
      "九三：高宗伐鬼方，三年克之，小人勿用。",
      "六四：繻有衣袽，終日戒。",
      "九五：東鄰殺牛，不如西鄰之禴祭，實受其福。",
      "上六：濡其首，厲。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%97%A2%E6%BF%9F",
    "source_sha256": "e9099522d8013177a9316c8fc499a10b80d50edd18b3401cbd79b2d31ab58d78",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 64,
    "name": "火水未濟",
    "short_name": "未濟",
    "symbol": "䷿",
    "bits_bottom_up": "010101",
    "upper_trigram": "離",
    "lower_trigram": "坎",
    "judgment": "未濟：亨。小狐汔濟，濡其尾，无攸利。",
    "lines": [
      "初六：濡其尾，吝。",
      "九二：曳其輪，貞吉。",
      "六三：未濟，征凶，利涉大川。",
      "九四：貞吉，悔亡，震用伐鬼方，三年有賞于大。",
      "六五：貞吉，无悔，君子之光，有孚，吉。",
      "上九：有孚于飲酒，无咎，濡其首，有孚失是。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%9C%AA%E6%BF%9F",
    "source_sha256": "9dcd6ad074f7d0633872e3e83665e86bd3d2bc19a3ae23cb4ff0eb044e2b4a83",
    "text_version": "wikisource-2026-10-26"
  }
]