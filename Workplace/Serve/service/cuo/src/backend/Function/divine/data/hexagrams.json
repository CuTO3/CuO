[
  {
    "number": 1,
    "name": "乾為天",
    "short_name": "乾",
    "symbol": "䷀",
    "bits_bottom_up": "111111",
    "upper_trigram": "乾",
    "lower_trigram": "乾",
    "judgment": "乾：元亨。利貞。",
    "lines": [
      "初九：潛龍勿用。",
      "九二：見龍在田，利見大人。",
      "九三：君子終日乾乾，夕惕若；厲，无咎。",
      "九四：或躍在淵，无咎。",
      "九五：飛龍在天，利見大人。",
      "上九：亢龍，有悔。"
    ],
    "special_text": "用九：見羣龍无首，吉。",
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E4%B9%BE",
    "source_sha256": "e8b8c4a93f7e1f86e00e83635a12423da0e134ec463ea21837f6a41b41661156",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 2,
    "name": "坤為地",
    "short_name": "坤",
    "symbol": "䷁",
    "bits_bottom_up": "000000",
    "upper_trigram": "坤",
    "lower_trigram": "坤",
    "judgment": "坤：元亨。利牝馬之貞。",
    "lines": [
      "初六：履霜，堅冰至。",
      "六二：直方大，不習无不利。",
      "六三：含章，可貞。或從王事，无成有終。",
      "六四：括囊，无咎无譽。",
      "六五：黃裳，元吉。",
      "上六：龍戰于野，其血玄黃。"
    ],
    "special_text": "用六：利永貞。",
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%9D%A4",
    "source_sha256": "a229442f54886cd2b21b1b6ab19cb377c4c59e5fcd8ac6b75f44b846459ca881",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 3,
    "name": "水雷屯",
    "short_name": "屯",
    "symbol": "䷂",
    "bits_bottom_up": "100010",
    "upper_trigram": "坎",
    "lower_trigram": "震",
    "judgment": "屯：元亨，利貞。勿用有攸往，利建侯。",
    "lines": [
      "初九：桓，利居貞，利建侯。",
      "六二：屯如邅如，乘馬班如，匪寇婚媾，女子貞不字，十年乃字。",
      "六三：即鹿无虞，惟入于林中，君子幾不如舍，往吝。",
      "六四：乘馬班如，求婚媾，往，吉无不利。",
      "九五：屯其膏；小貞吉，大貞凶。",
      "上六：乘馬班如，泣血漣如。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B1%AF",
    "source_sha256": "46e879adeb27dcbf7d8b7d0763fddf786025ad617ea3dccf364195467e8c4096",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 4,
    "name": "山水蒙",
    "short_name": "蒙",
    "symbol": "䷃",
    "bits_bottom_up": "010001",
    "upper_trigram": "艮",
    "lower_trigram": "坎",
    "judgment": "蒙：亨。匪我求童蒙，童蒙求我。初筮告，再三瀆，瀆則不告。利貞。",
    "lines": [
      "初六：發蒙，利用刑人，用說桎梏，以往吝。",
      "九二：包蒙吉，納婦吉，子克家。",
      "六三：勿用女，見金夫，不有躬，无攸利。",
      "六四：困蒙，吝。",
      "六五：童蒙，吉。",
      "上九：擊蒙，不利為寇，利禦寇。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%92%99",
    "source_sha256": "82968b32bb6552880209f9578ada9d2e30beadcc1fd2c59ee7d331c48dc9ea7b",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 5,
    "name": "水天需",
    "short_name": "需",
    "symbol": "䷄",
    "bits_bottom_up": "111010",
    "upper_trigram": "坎",
    "lower_trigram": "乾",
    "judgment": "需：有孚，光亨。貞吉，利涉大川。",
    "lines": [
      "初九：需于郊，利用恆，无咎。",
      "九二：需于沙，小有言，終吉。",
      "九三：需于泥，致寇至。",
      "六四：需于血，出自穴。",
      "九五：需于酒食，貞吉。",
      "上六：入于穴，有不速之客三人來，敬之終吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%9C%80",
    "source_sha256": "ccff1d03f4da5a90b388b3ec308fef5aa49ad588ad480be8627d633a3ad5bac3",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 6,
    "name": "天水訟",
    "short_name": "訟",
    "symbol": "䷅",
    "bits_bottom_up": "010111",
    "upper_trigram": "乾",
    "lower_trigram": "坎",
    "judgment": "訟：有孚，窒，惕，中吉，終凶。利見大人，不利涉大川。",
    "lines": [
      "初六：不永所事，小有言，終吉。",
      "九二：不克訟，歸而逋，其邑人三百戶无眚。",
      "六三：食舊德，貞厲，終吉。或從王事，无成。",
      "九四：不克訟，復即命渝，安貞吉。",
      "九五：訟，元吉。",
      "上九：或錫之鞶帶，終朝三之。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%A8%9F",
    "source_sha256": "8c6b14ac0b22d80ed48dd164132905c4dbdec9b3dda633744271e4bef064ee81",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 7,
    "name": "地水師",
    "short_name": "師",
    "symbol": "䷆",
    "bits_bottom_up": "010000",
    "upper_trigram": "坤",
    "lower_trigram": "坎",
    "judgment": "師：貞丈人吉，无咎。",
    "lines": [
      "初六：師出以律，否臧，凶。",
      "九二：在師中吉，无咎；王三錫命。",
      "六三：師或輿尸，凶。",
      "六四：師左次，无咎。",
      "六五：田有禽，利執言，无咎。長子帥師，弟子輿尸，貞凶。",
      "上六：大君有命，開國承家，小人勿用。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B8%AB",
    "source_sha256": "131b206cbc0995b1adfdab9560e66d7843fd85e3172bb4e9f89bb37e4665c1f9",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 8,
    "name": "水地比",
    "short_name": "比",
    "symbol": "䷇",
    "bits_bottom_up": "000010",
    "upper_trigram": "坎",
    "lower_trigram": "坤",
    "judgment": "比：吉。原筮元永貞，无咎。不寧方來，後夫凶。",
    "lines": [
      "初六：有孚，比之，无咎。有孚盈缶，終來有它，吉。",
      "六二：比之自內，貞吉。",
      "六三：比之匪人。",
      "六四：外比之，貞吉。",
      "九五：顯比。王用三，失前禽，邑人不誡，吉。",
      "上六：比之无首，凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%AF%94",
    "source_sha256": "c722de4c7a95194e064b0c39c40c4712af8f007bf2186bc0d4f207e1fb0406e0",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 9,
    "name": "風天小畜",
    "short_name": "小畜",
    "symbol": "䷈",
    "bits_bottom_up": "111011",
    "upper_trigram": "巽",
    "lower_trigram": "乾",
    "judgment": "小畜：亨。密雲不雨，自我西郊。",
    "lines": [
      "初九：復自道，何其咎，吉。",
      "九二：牽復，吉。",
      "九三：說，夫妻反目。",
      "六四：有孚，血去惕出，无咎。",
      "九五：有孚攣如，富以其鄰。",
      "上九：既雨既處，尚載，婦貞厲，月幾望，君子征凶。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B0%8F%E7%95%9C",
    "source_sha256": "6e1e827c09da249c5391f31c860080fd05657107b62c7e109c31a038349aebb9",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 10,
    "name": "天澤履",
    "short_name": "履",
    "symbol": "䷉",
    "bits_bottom_up": "110111",
    "upper_trigram": "乾",
    "lower_trigram": "兌",
    "judgment": "履虎尾，不咥人，亨。",
    "lines": [
      "初九：素履，往无咎。",
      "九二：履道坦坦，幽人貞吉。",
      "六三：眇能視，跛能履，履虎尾，咥人，凶。武人為于大君。",
      "九四：履虎尾，愬愬終吉。",
      "九五：夬履，貞厲。",
      "上九：視履考詳，其旋元吉。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%B1%A5",
    "source_sha256": "4cba3bd1b9e4d13bb34a71531611e37bebb7801d8e783c86870912540453cd49",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 11,
    "name": "地天泰",
    "short_name": "泰",
    "symbol": "䷊",
    "bits_bottom_up": "111000",
    "upper_trigram": "坤",
    "lower_trigram": "乾",
    "judgment": "泰：小往大來，吉亨。",
    "lines": [
      "初九：拔茅茹以其彙，征吉。",
      "九二：包荒。用馮河，不遐遺；朋亡。得尚于中行。",
      "九三：无平不陂，无往不復，艱貞无咎。勿恤其孚，于食有福。",
      "六四：翩翩，不富以其鄰；不戒以孚。",
      "六五：帝乙歸妹，以祉，元吉。",
      "上六：城復于隍，勿用師，自邑告命，貞吝。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E6%B3%B0",
    "source_sha256": "ecd49dba63369af09ab717293badc4b5823106b89c25ee5ebed44466817616e7",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 12,
    "name": "天地否",
    "short_name": "否",
    "symbol": "䷋",
    "bits_bottom_up": "000111",
    "upper_trigram": "乾",
    "lower_trigram": "坤",
    "judgment": "否之匪人，不利君子貞，大往小來。",
    "lines": [
      "初六，拔茅茹以其彙，貞吉。亨。",
      "六二，包承，小人吉，大人否。亨。",
      "六三，包羞。",
      "九四，有命，无咎，疇離祉。",
      "九五，休否，大人吉。其亡其亡，繫于桑。",
      "上九，傾否，先否後喜。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%90%A6",
    "source_sha256": "40db949fcb2f204562ec6ba5377425cbc4261c46cc04e0748fdf399d5bb56fef",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 13,
    "name": "天火同人",
    "short_name": "同人",
    "symbol": "䷌",
    "bits_bottom_up": "101111",
    "upper_trigram": "乾",
    "lower_trigram": "離",
    "judgment": "同人于野，亨。 利涉大川，利君子貞。",
    "lines": [
      "初九：同人于門，無咎。",
      "六二：同人于宗，吝。",
      "九三：伏戎于莽，升其高陵，三歲不興。",
      "九四：乘其，弗克攻，吉。",
      "九五：同人，先號啕而後笑。大師克相遇。",
      "上九：同人于郊，無悔。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%90%8C%E4%BA%BA",
    "source_sha256": "c60417d5fd75abf7a958e368c092afadb2357e0d1af69085a1abe990c05a3d37",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 14,
    "name": "火天大有",
    "short_name": "大有",
    "symbol": "䷍",
    "bits_bottom_up": "111101",
    "upper_trigram": "離",
    "lower_trigram": "乾",
    "judgment": "大有：元亨。",
    "lines": [
      "初九：无交害，匪咎，艱則无咎。",
      "九二：大以載，有攸往，无咎。",
      "九三：公用亨于天子，小人弗克。",
      "九四：匪其，无咎。",
      "六五：厥孚交如，威如；吉。",
      "上九：自天之，吉无不利。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E5%A4%A7%E6%9C%89",
    "source_sha256": "3c4fdab8bfd0a57bfe53c483c5ad32a308d58094167a8dbb52b16c8c4c26ef0c",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 15,
    "name": "地山謙",
    "short_name": "謙",
    "symbol": "䷎",
    "bits_bottom_up": "001000",
    "upper_trigram": "坤",
    "lower_trigram": "艮",
    "judgment": "謙：亨，君子有終。",
    "lines": [
      "初六：謙謙君子，用涉大川，吉。",
      "六二：鳴謙，貞吉。",
      "九三：勞謙君子，有終吉。",
      "六四：无不利，撝謙。",
      "六五：不富，以其鄰，利用侵伐，无不利。",
      "上六：鳴謙，利用行師，征邑國。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%AC%99",
    "source_sha256": "2ffb3b0269b10fe966f76b4dd96b49503733677215fa6b9df7414a0a903d3700",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 16,
    "name": "雷地豫",
    "short_name": "豫",
    "symbol": "䷏",
    "bits_bottom_up": "000100",
    "upper_trigram": "震",
    "lower_trigram": "坤",
    "judgment": "豫：利建侯行師。",
    "lines": [
      "初六：鳴豫，凶。",
      "六二：介于石，不終日，貞吉。",
      "六三：盱豫，悔。遲有悔。",
      "九四：由豫，大有得。勿疑。朋盍。",
      "六五：貞疾，恆不死。",
      "上六：冥豫，成有渝，无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%B1%AB",
    "source_sha256": "65bf434245ce44f90a7034ebef4159cd64b85f7cdb099c7f52e8820215bbfe5b",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 17,
    "name": "澤雷隨",
    "short_name": "隨",
    "symbol": "䷐",
    "bits_bottom_up": "100110",
    "upper_trigram": "兌",
    "lower_trigram": "震",
    "judgment": "隨：元亨。利貞。无咎。",
    "lines": [
      "初九：官有渝，貞吉。出門交有功。",
      "六二：係小子，失丈夫。",
      "六三：係丈夫，失小子。隨，有求得利，居貞。",
      "九四：隨有獲，貞凶。有孚在道，以明，何咎。",
      "九五：孚于嘉，吉。",
      "上六：拘係之，乃從維之。王用亨于西山。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E9%9A%A8",
    "source_sha256": "af3531608314476f887b4c8adc97ccf6c2ca09abf5718d4643be598cdda4a8d0",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 18,
    "name": "山風蠱",
    "short_name": "蠱",
    "symbol": "䷑",
    "bits_bottom_up": "011001",
    "upper_trigram": "艮",
    "lower_trigram": "巽",
    "judgment": "蠱：元亨。利涉大川。先甲三日，後甲三日。",
    "lines": [
      "初六：幹父之蠱，有子考，无咎，厲終吉。",
      "九二：幹母之蠱，不可貞。",
      "九三：幹父之蠱，小有悔，无大咎。",
      "六四：裕父之蠱，往見吝。",
      "六五：幹父之蠱，用譽。",
      "上九：不事王侯，高尚其事。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%A0%B1",
    "source_sha256": "b823e1f7c186f7ae3ea27e22955595a873311c8c8f1c00a1b09d00f887df6a5a",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 19,
    "name": "地澤臨",
    "short_name": "臨",
    "symbol": "䷒",
    "bits_bottom_up": "110000",
    "upper_trigram": "坤",
    "lower_trigram": "兌",
    "judgment": "臨：元亨。利貞。至于八月有凶。",
    "lines": [
      "初九：咸臨，貞吉。",
      "九二：咸臨，吉无不利。",
      "六三：甘臨，无攸利。既憂之，无咎。",
      "六四：至臨，无咎。",
      "六五：知臨，大君之宜，吉。",
      "上六：敦臨，吉无咎。"
    ],
    "special_text": null,
    "source_url": "https://zh.wikisource.org/wiki/%E5%91%A8%E6%98%93/%E8%87%A8",
    "source_sha256": "beadffbfc5356c83e7068507a7446efbe4c175eeec1c3845ec634e288f3217cc",
    "text_version": "wikisource-2026-10-26"
  },
  {
    "number": 20,
    "name": "風地觀",
    "short_name": "觀",
    "symbol": "䷓",
    "bits_bottom_up": "000011",
    "upper_trigram": "巽",
    "lower_trigram": "坤",
    "judgment": "觀：盥而不薦，有孚顒若。",
    "lines": [
      "初六：童觀，小人无咎，君子吝。",
      "六二：窺觀，利女貞。",
      "六三：觀我生，進退。",
      "六四：觀國之光，利用賓于王。",
      "九五：觀我生，君子无咎。",
      "上九：觀其生，君子无咎。"
    ],
    "special_text": null,
