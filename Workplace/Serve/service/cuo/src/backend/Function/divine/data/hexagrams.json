    "lines": [
      "初六：往蹇，来誉。",
      "六二：王臣蹇蹇，匪躬之故。",
      "九三：往蹇来反。",
      "六四：往蹇来连。",
      "九五：大蹇朋来。",
      "上六：往蹇来硕，吉；利见大人。"
    ],
