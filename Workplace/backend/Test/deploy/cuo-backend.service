[Unit]
Description=CuO group assistant
After=network-online.target postgresql@18-main.service
Wants=network-online.target
Requires=postgresql@18-main.service

[Service]
Type=simple
User=cuo
Group=cuo
SupplementaryGroups=cuo-files
WorkingDirectory=/serve/workspace/program/cuo/backend
Environment=CUO_ENV_FILE=/serve/config/cuo/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/serve/workspace/program/cuo/backend/.venv/bin/python -m uvicorn Main:app --host 127.0.0.1 --port 8080 --workers 1
Restart=on-failure
RestartSec=10
TimeoutStopSec=75
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/serve/data/cuo /serve/workspace/program/cuo/backend/Function /serve/workspace/program/cuo/backend/database

[Install]
WantedBy=multi-user.target
